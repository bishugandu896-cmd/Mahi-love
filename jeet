async function callClaude(messages,system="",maxTokens=800){
  const r=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({model:"claude-sonnet-4-20250514",max_tokens:maxTokens,system,messages})});
  const d=await r.json();
  return d.content?.map(b=>b.text||"").join("")||"";
}

async function generateConfig(bot){
  const sys=`You are BotWala AI. Return ONLY valid JSON, no markdown, no extra text.
{
  "greeting":"...",
  "menuText":"...",
  "responses":{"book":"...","price":"...","hours":"...","location":"...","default":"..."},
  "quickReplies":["...","...","...","..."],
  "personality":"..."
}
Language: hinglish=natural Hindi+English roman, hindi=roman Hindi, english=English. Use emojis. Max 4 lines per response.`;
  const prompt=`Name:${bot.name} Type:${bot.type} Services:${bot.services||"standard"} Hours:${bot.hours||"9am-9pm"} Location:${bot.location||"\u2014"} Language:${bot.lang} Extra:${bot.extra||"none"}`;
  const text=await callClaude([{role:"user",content:prompt}],sys,1000);
  try{return JSON.parse(text.replace(/```json|```/g,"").trim());}catch{return null;}
}

async function chatReply(bot,cfg,history,userMsg){
  const sys=`You are a WhatsApp chatbot for "${bot.name}" (${bot.type}).
Personality:${cfg?.personality||"friendly"}. Language:${bot.lang}.
Services:${bot.services||"standard"}. Hours:${bot.hours||"9-9"}. Location:${bot.location||"\u2014"}.
Reply in max 4 lines, no markdown, use emojis, be helpful.`;
  const msgs=[...history.slice(-6).map(m=>({role:m.role,content:m.text})),{role:"user",content:userMsg}];
  return callClaude(msgs,sys,250);
}

